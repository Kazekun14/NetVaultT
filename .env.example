# NetVaultT - Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Application URL
APP_URL=http://localhost:5000

# Master Encryption Key (Must be 32 bytes represented as a 64-character hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NETVAULT_MASTER_KEY=

# Server Session Secret
SESSION_SECRET=

# PostgreSQL runtime connection (database must already exist)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netvaultt
DB_USER=your_postgresql_user
DB_PASSWORD=your_postgresql_password
DB_POOL_SIZE=10

# Time Zone
DEFAULT_TIMEZONE=Asia/Manila

