# NetVaultT - Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Application URL
APP_URL=http://localhost:5000

# Master Encryption Key (Must be 32 bytes represented as a 64-character hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NETVAULT_MASTER_KEY=

# Server Session Secret
SESSION_SECRET=

# Database File / Connection
# For SQLite (default): db path or file name
DATABASE_PATH=./netvault.db

# Time Zone
DEFAULT_TIMEZONE=Asia/Manila

